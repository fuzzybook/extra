<!doctype html>
<html>
  <body>
    <p>Hi {{ .Name }},</p>
    <p>We received a request to reset the password for {{ .Email }}.</p>
    <p>
      Set a new password by opening this link:<br />
      <a href="{{ .PasswordResetURL }}">{{ .PasswordResetURL }}</a>
    </p>
    <p>If you did not request this, you can ignore this email.</p>
  </body>
</html>
