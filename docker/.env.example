# =============================================================================
# Configurazione Porte
# =============================================================================
FRONTEND_PORT=8080
FRONTEND_SSL_PORT=8443
BACKEND_PORT=4000
BACKEND_DASHBOARD_PORT=9400
POSTGRES_PORT=5432
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

# =============================================================================
# Database PostgreSQL
# =============================================================================
POSTGRES_USER=extra
POSTGRES_PASSWORD=extrasecret
POSTGRES_DB=extra

# =============================================================================
# Segreti Backend Encore
# =============================================================================
# Pepper segreto per l'hashing BCrypt delle password
PASSWORD_PEPPER=__generare_con_openssl_rand_hex_32__

# Credenziali LiveKit (default per il container locale o LiveKit Cloud)
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Webhook LiveKit → backend: aggiorna lo stato delle stanze (aperta, video,
# microfono) per il sito pubblico. Firmato con LIVEKIT_API_KEY/SECRET.
LIVEKIT_WEBHOOK_URL=http://backend:4000/videochat/livekit/webhook
